{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "public",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/museum",
          "destination": "/location-and-hours",
          "type": 301
        },
        {
          "source": "/about",
          "destination": "/about-sahs",
          "type": 301
        },
        {
          "source": "/contact",
          "destination": "/contact-sahs",
          "type": 301
        },
        {
          "source": "/support",
          "destination": "/support-sahs",
          "type": 301
        },
        {
          "source": "/events",
          "destination": "/news",
          "type": 301
        },
        {
          "source": "/membership-status",
          "destination": "https://billing.stripe.com/p/login/3cscOSe99bt8bvi000",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "shortlinks",
      "public": "hosting-shortlinks",
      "rewrites": [
        {
          "source": "**",
          "function": "shortlinkRedirect"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "website",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
