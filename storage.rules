rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // These rules govern `sahs-website-media` ONLY.
    //
    // They used to be deployed to `sahs-archives.firebasestorage.app`, which
    // archive-app also deploys to — so whichever repo merged most recently owned the
    // policy and silently discarded the other's. The two were incompatible: this file
    // granted `allow read: if true` bucket-wide, while archive-app grants no anonymous
    // read at all, having moved public visibility to per-object ACLs precisely so
    // private items would stop being served. Every website deploy reverted that.
    //
    // `firebase.json` now scopes storage to the `website-media` target, so
    // `deploy --only storage` from this repo cannot reach the shared bucket at all.
    // Keep it that way — the coupling is only gone as long as that target list is.
    //
    // See docs/storage-bucket-separation.md.

    // ── Role helpers ────────────────────────────────────────────────────────────
    //
    // These mirror `firestore.rules`, and must keep mirroring it. This file once had
    // its own `isSAHSUser()` comparing two hardcoded addresses that never read
    // `user_roles`, so Storage and Firestore had drifted into two auth models under
    // one name: an editor could write a post but not attach its artwork, and the
    // failure landed mid-workflow rather than at the door.
    //
    // Unlike archive-app — whose Firestore is the *named* `sahs-archives` database,
    // which Storage rules cannot query, and which is why it mirrors roles onto Auth
    // custom claims — the website's `user_roles` lives in the DEFAULT database, which
    // Storage rules CAN read. So the role document is the single source of truth.
    //
    // NOTE: `firestore.get()` from Storage rules is not implemented by the Storage
    // emulator (cloud-storage-rules-runtime evaluates it to null), so those cases are
    // skipped in `test/rules/storage.test.mjs` and this clause can only be verified
    // against a deployed project. The custom-claim path below IS covered by tests.
    // After changing this file, check by hand: sign in as an editor, attach an image.
    function roleOf() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/user_roles/$(request.auth.token.email.lower()))
        ? firestore.get(/databases/(default)/documents/user_roles/$(request.auth.token.email.lower())).data.role
        : '';
    }

    function isPermanentAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'catnolan@senoiahistory.com' ||
        request.auth.token.email.lower() == 'jeremywarren@senoiahistory.com'
      );
    }

    // Editors and above may upload. `role` is also honoured as an Auth custom claim,
    // which archive-app's syncUserRoleClaims already mirrors from user_roles — cheap
    // to accept, and it keeps working if the Firestore lookup is ever unavailable.
    function isEditor() {
      return isPermanentAdmin() ||
        roleOf() in ['admin', 'curator', 'editor'] ||
        (request.auth != null && request.auth.token.get('role', '') in ['admin', 'curator', 'editor']);
    }

    match /{allPaths=**} {
      // Public read is correct here, and now it is also *honest*: this bucket holds
      // only website images — post artwork, historic-place photos, inline article
      // images — every one of which is served to anonymous visitors by download URL
      // from the public site. It no longer says anything about archive media.
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
